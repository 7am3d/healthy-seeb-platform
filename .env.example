# Password for the local PostgreSQL container (docker-compose.yml)
POSTGRES_PASSWORD=change-me

# PostgreSQL connection string. The Docker database listens on port 5433.
DATABASE_URL=postgres://postgres:change-me@127.0.0.1:5433/healthy_seeb_platform

# Long random string used by Payload to sign logins (e.g. `openssl rand -hex 32`)
PAYLOAD_SECRET=YOUR_SECRET_HERE
